#!/bin/sh
# jname - quick DNS overview of a domain: A, AAAA, www, NS, MX, TXT, SOA, CAA and DMARC.
#
# POSIX sh: runs the same on macOS and Linux. Needs `dig`; if it is missing jname offers to install it
# (brew on macOS; apt-get, dnf, yum, pacman, zypper or apk on Linux).
#
#   jname example.com
#   jname -s 1.1.1.1 example.com
set -u

PROG=${0##*/}

usage() {
    cat <<EOF
Usage: $PROG [-s SERVER] [-y] DOMAIN

  -s SERVER   ask this DNS server (name or IP) instead of the system resolver
  -y          install dig without asking if it is missing
  -h          show this help

Exit codes: 0 ok, 1 bad usage, 2 domain does not exist (NXDOMAIN),
            3 a DNS lookup failed or timed out, 127 dig is missing
EOF
}

die() {  # die CODE MESSAGE
    printf '%s: %s\n' "$PROG" "$2" >&2
    exit "$1"
}

# ---------------------------------------------------------------- arguments
SERVER=""
ASSUME_YES=0
DOMAIN=""
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -y|--yes) ASSUME_YES=1 ;;
        -s) [ $# -ge 2 ] || die 1 "-s needs a server name or address"
            SERVER=$2
            shift ;;
        -*) die 1 "unknown option: $1 (try -h)" ;;
        *) [ -z "$DOMAIN" ] || die 1 "give one domain at a time"
           DOMAIN=$1 ;;
    esac
    shift
done
if [ -z "$DOMAIN" ]; then
    usage >&2
    exit 1
fi

# The domain and server end up on dig's command line, so only accept plain, safe names.
if printf '%s' "$DOMAIN" | LC_ALL=C grep -q '[^ -~]'; then
    die 1 "non-ASCII domain: use the punycode form (xn--...)"
fi
DOMAIN=$(printf '%s' "$DOMAIN" | tr '[:upper:]' '[:lower:]')
DOMAIN=${DOMAIN%.}                                   # a trailing dot is fine
LABEL='[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?'
if [ "${#DOMAIN}" -gt 253 ] || ! printf '%s' "$DOMAIN" | grep -Eq "^$LABEL(\\.$LABEL)*\$"; then
    die 1 "'$DOMAIN' is not a valid domain name"
fi
if [ -n "$SERVER" ] && ! printf '%s' "$SERVER" | grep -Eq '^[A-Za-z0-9:][A-Za-z0-9.:_-]*$'; then
    die 1 "'$SERVER' is not a valid DNS server name or address"
fi

# ----------------------------------------------------------------- dig check
install_dig() {
    sudo_cmd=""
    if [ "$(uname -s)" = "Darwin" ]; then
        brew=$(command -v brew 2>/dev/null || true)
        if [ -z "$brew" ]; then
            for p in /opt/homebrew/bin/brew /usr/local/bin/brew; do
                if [ -x "$p" ]; then brew=$p; break; fi
            done
        fi
        [ -n "$brew" ] || die 127 "dig is missing and Homebrew is not installed (https://brew.sh), then: brew install bind"
        cmd="$brew install bind"
        # Homebrew refuses to run as root: go back to the user who started sudo.
        if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
            cmd="sudo -u $SUDO_USER $cmd"
        fi
    else
        pm=""
        for m in apt-get dnf yum pacman zypper apk; do
            if command -v "$m" >/dev/null 2>&1; then pm=$m; break; fi
        done
        case $pm in
            apt-get) cmd="apt-get install -y dnsutils" ;;
            dnf)     cmd="dnf install -y bind-utils" ;;
            yum)     cmd="yum install -y bind-utils" ;;
            pacman)  cmd="pacman -S --noconfirm bind" ;;
            zypper)  cmd="zypper --non-interactive install bind-utils" ;;
            apk)     cmd="apk add bind-tools" ;;
            *)       die 127 "dig is missing and no supported package manager was found; install dnsutils / bind-utils / bind-tools" ;;
        esac
        if [ "$(id -u)" -ne 0 ]; then
            command -v sudo >/dev/null 2>&1 || die 127 "dig is missing; run as root: $cmd"
            cmd="sudo $cmd"
        fi
    fi
    printf '%s: dig is not installed.\n  install with: %s\n' "$PROG" "$cmd" >&2
    if [ "$ASSUME_YES" -ne 1 ]; then
        [ -t 0 ] || exit 127
        printf '  Run it now? [Y/n] ' >&2
        read -r ans || exit 127
        case $ans in
            ""|y|Y|yes|YES) ;;
            *) exit 127 ;;
        esac
    fi
    $cmd || die 127 "the install failed; run the command above yourself"   # fixed strings, safe to word-split
    command -v dig >/dev/null 2>&1 || die 127 "dig is still not available after the install"
}

command -v dig >/dev/null 2>&1 || install_dig

# -------------------------------------------------------------------- lookups
FAILED=0
STATUS=""
ROWS=""

# lookup GROUP TYPE NAME: one dig query. Appends tab-separated rows (group, type, name, ttl, value) to ROWS
# and sets STATUS (NOERROR, NXDOMAIN, TIMEOUT, ...). Nothing is printed here; the table is drawn at the end.
lookup() {
    out=$(dig +noall +answer +comments +time=3 +tries=1 ${SERVER:+"@$SERVER"} "$3" "$2" 2>&1)
    rc=$?
    STATUS=$(printf '%s\n' "$out" | sed -n 's/.*status: \([A-Z]*\).*/\1/p' | head -n 1)
    if [ "$rc" -eq 9 ]; then
        STATUS=TIMEOUT
    elif [ -z "$STATUS" ]; then
        STATUS=ERROR
    fi
    msg=""
    case $STATUS in
        NOERROR) ;;
        NXDOMAIN) return 0 ;;
        TIMEOUT) msg="(no answer from ${SERVER:-the system resolver})"; FAILED=1 ;;
        *) msg="(lookup failed: $STATUS)"; FAILED=1 ;;
    esac
    if [ -z "$msg" ]; then
        found=$(printf '%s\n' "$out" | grep -v '^;' | grep -v '^[[:space:]]*$' | awk -v g="$1" '{
            v = $0
            sub(/^[^ \t]+[ \t]+[^ \t]+[ \t]+[^ \t]+[ \t]+[^ \t]+[ \t]*/, "", v)
            gsub(/\t/, " ", v)
            name = $1
            sub(/\.$/, "", name)
            if (name == "") name = "."
            printf "%s\t%s\t%s\t%s\t%s\n", g, $4, name, $2, v
        }')
        if [ -n "$found" ]; then
            ROWS=$(printf '%s\n%s' "$ROWS" "$found")
            return 0
        fi
        msg="(none)"
    fi
    ROWS=$(printf '%s\n%s\t%s\t%s\t-\t%s' "$ROWS" "$1" "$2" "$3" "$msg")
}

# Terminal width for the table: $COLUMNS, else the tty size, else 100 (when piped or redirected).
table_width() {
    w=${COLUMNS:-}
    if [ -z "$w" ] && [ -t 1 ]; then
        w=$(tput cols 2>/dev/null || true)
    fi
    case $w in
        ''|*[!0-9]*) w=100 ;;
    esac
    [ "$w" -ge 60 ] || w=60
    printf '%s' "$w"
}

# Draws ROWS as a grid: "|" between columns, "+---+" rules above, below and between lookups, "+===+" under the
# header. Columns are as wide as their longest entry; a long VALUE wraps inside its cell to fit the terminal.
print_table() {
    printf '%s\n' "$ROWS" | awk -v maxw="$(table_width)" '
        function rep(c, len,   out) { out = ""; while (len-- > 0) out = out c; return out }
        function rule(c) { return "+" c rep(c, ct) c "+" c rep(c, cn) c "+" c rep(c, cl) c "+" c rep(c, cv) c "+" }
        # split s into pieces of at most w characters, preferring to break at a space; returns the count
        function wrap(s, w, parts,   n, cut, i, sp) {
            split("", parts)
            n = 0
            while (length(s) > w) {
                cut = w; sp = 0
                for (i = w; i > int(w * 0.6); i--) if (substr(s, i, 1) == " ") { cut = i; sp = 1; break }
                if (sp) { parts[++n] = substr(s, 1, cut - 1); s = substr(s, cut + 1) }
                else    { parts[++n] = substr(s, 1, w);       s = substr(s, w + 1) }
            }
            parts[++n] = s
            return n
        }
        BEGIN { FS = "\t" }
        NF < 5 { next }
        {
            k++; gg[k] = $1; tt[k] = $2; nn[k] = $3; ll[k] = $4; vv[k] = $5
            if (length($2) > ct) ct = length($2)
            if (length($3) > cn) cn = length($3)
            if (length($4) > cl) cl = length($4)
            if (length($5) > wv) wv = length($5)
        }
        END {
            if (ct < 4) ct = 4
            if (cn < 4) cn = 4
            if (cl < 3) cl = 3
            room = maxw - (ct + cn + cl) - 13          # 13 = the borders and padding around four columns
            if (room < 20) room = 20
            cv = (wv < room) ? wv : room
            if (cv < 5) cv = 5
            fmt = "| %-" ct "s | %-" cn "s | %" cl "s | %-" cv "s |\n"
            print rule("-")
            printf fmt, "TYPE", "NAME", "TTL", "VALUE"
            print rule("=")
            for (i = 1; i <= k; i++) {
                if (i > 1 && gg[i] != gg[i - 1]) print rule("-")
                m = wrap(vv[i], cv, parts)
                printf fmt, tt[i], nn[i], ll[i], parts[1]
                for (j = 2; j <= m; j++) printf fmt, "", "", "", parts[j]
            }
            print rule("-")
        }'
}

printf '\n'
echo "Here's your request of domain: $DOMAIN   (resolver: ${SERVER:-system default})"
printf '\n'

lookup A A "$DOMAIN"
case $STATUS in
    NXDOMAIN) echo "$DOMAIN does not exist (NXDOMAIN)."; printf '\n'; exit 2 ;;
    TIMEOUT)  echo "Giving up: the DNS server did not answer."; printf '\n'; exit 3 ;;
esac
lookup AAAA AAAA "$DOMAIN"
case $DOMAIN in
    www.*) ;;
    *) lookup WWW A "www.$DOMAIN" ;;
esac
lookup NS NS "$DOMAIN"
lookup MX MX "$DOMAIN"
lookup TXT TXT "$DOMAIN"
lookup SOA SOA "$DOMAIN"
lookup CAA CAA "$DOMAIN"
lookup DMARC TXT "_dmarc.$DOMAIN"

print_table
printf '\n'
[ "$FAILED" -eq 0 ] || exit 3
exit 0
